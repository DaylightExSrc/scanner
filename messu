		if Config.AUTO_HOP then
			Hopper.hop()
			task.wait(2)
		else
			-- staying put: keep watching this server for new brainrots
			task.wait(8)
			if not Config.AUTO_HOP then runScan(); task.spawn(function() pcall(Steals.relay); pcall(Status.beat) end) end
		end
	end
