-- posts to a webhook; if Discord says "slow down" (429) it waits what Discord asks and tries again
local function postHook(url, body)
	local res
	for _ = 1, 3 do
		res = request({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
		if not res or res.StatusCode ~= 429 then return res end
		local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
		local wait = ok and type(d) == "table" and tonumber(d.retry_after) or 1
		task.wait(math.clamp(wait, 0.2, 3))
	end
	return res
end

local function sendCard(list, hook, forcedCat)
	if not hook or hook == "" or #list == 0 then return end
	list = table.clone(list)
	table.sort(list, function(a, b) return a.mps > b.mps end) -- best first
	local best = list[1]
	local players, maxPlayers = #Players:GetPlayers(), Players.MaxPlayers
	local now = os.time()
	local tier = TIER_STYLE[tostring(best.tierName)] or { "✦", 0xAAAAB0 }
	local mut = best.mutation and MUT_STYLE[tostring(best.mutation):lower()]
	local color = (mut and mut[2]) or tier[2]
	-- wiki picture, but never hold the log up for it (cached after the first time)
	local img
	if State.images[best.name] ~= nil then
		img = brainrotImage(best.name)
	else
		local done
		task.spawn(function() img = brainrotImage(best.name); done = true end)
		local t0 = os.clock()
		while not done and os.clock() - t0 < 0.6 do task.wait(0.03) end
	end
	img = img or mutationIcon(best.mutation)
	local total = 0
	for _, f in ipairs(list) do total += f.mps end

	local cat = forcedCat or category(best.mps)
	local CAT_ICON = { ["OG Logs"] = "👑", Ultralights = "💎", Highlights = "⚡", Midlights = "✨", Lowlights = "🌱" }
	local count = #list
	local D = Animals.Data and Animals.Data()
	local info = D and type(D[best.name]) == "table" and D[best.name] or nil
	local price = info and tonumber(info.Price) or 0
	local function money(n) return (fmtMoney(n):gsub("/s$", "")) end

	-- header
	local header = table.concat({
		("-# INFIN AJ  ·  PREMIUM LOGS"),
		("## %s %s"):format(CAT_ICON[cat] or "✨", cat),
	}, "\n")

	-- the best find
	local bl = {}
	if best.carpet then table.insert(bl, "🟥 **ON THE CARPET**  ·  buy it before it walks off") end
	local bestEmo = mutEmoji(best.mutation)
	table.insert(bl, ("## %s%s"):format(bestEmo and (bestEmo .. " ") or "", best.name))
	table.insert(bl, ("### 💸 %s%s"):format(best.exact and "" or "≈", fmtMoney(best.mps)))
	local tags = {}
	table.insert(tags, (bestEmo and (bestEmo .. " ") or "") .. "**" .. (best.mutation or "Normal") .. "**")
	table.insert(tags, tier[1] .. " **" .. tostring(best.tierName or "Unknown") .. "**")
	if price > 0 then table.insert(tags, "🪙 **" .. money(price) .. "**") end
	table.insert(bl, table.concat(tags, "  ┃  "))
	if best.owner then table.insert(bl, "-# 🏠 base of @" .. best.owner) end
	local bestText = table.concat(bl, "\n")

	-- "Other": stack duplicates as 2x, 3x...
	local groups, order = {}, {}
	for i = 2, #list do
		local f = list[i]
		local key = f.name .. "|" .. tostring(f.mutation) .. "|" .. f.mps .. "|" .. tostring(f.carpet)
		if not groups[key] then
			groups[key] = { f = f, n = 0 }
			table.insert(order, key)
		end
		groups[key].n += 1
	end
	local other = {}
	for i, key in ipairs(order) do
		if i > 30 then
			table.insert(other, ("-# …and %d more"):format(#order - 30))
			break
		end
		local g = groups[key]
		local emo = mutEmoji(g.f.mutation)
		local unknownMut = g.f.mutation and not emo and (" *(" .. g.f.mutation .. ")*") or ""
		table.insert(other, ("`%dx` %s%s%s — **%s**%s"):format(g.n, emo and (emo .. " ") or "", g.f.name, unknownMut,
			fmtMoney(g.f.mps), g.f.carpet and "  🟥 carpet" or ""))
	end
	local otherText = #other > 0 and ("**OTHER BRAINROTS**\n" .. table.concat(other, "\n")) or nil

	local statsText = ("💰 **%s** total  ┃  👥 **%d/%d**  ┃  🧠 **%d** brainrot%s"):format(
