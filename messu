local function webIcons()
	if State.webIcons and State.webIcons.v == 2 then return State.webIcons end
	local ids = { tostring(LOGO_ID) }
	for _, id in pairs(MUTATION_ICON_IDS) do table.insert(ids, tostring(id)) end
	local data = httpGetJSON(("https://thumbnails.roblox.com/v1/assets?assetIds=%s&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false")
		:format(table.concat(ids, ",")))
	local byId = {}
	for _, t in ipairs(data and data.data or {}) do
		if t.state == "Completed" and type(t.imageUrl) == "string" then byId[tonumber(t.targetId)] = t.imageUrl end
	end
	local icons = { v = 2, logo = byId[LOGO_ID], mutations = {} }
	for name, id in pairs(MUTATION_ICON_IDS) do icons.mutations[name] = byId[id] end
	-- only keep it once every icon came back (Roblox sometimes says "Pending" the first time)
	local have = 0
	for _ in pairs(icons.mutations) do have += 1 end
	if icons.logo and have >= 13 then
		State.webIcons = icons
		saveState()
	end
	return icons
end

