		components = { { type = 17, accent_color = color, components = parts } },
		allowed_mentions = { parse = {} },
	}))
	if res and res.StatusCode and res.StatusCode < 300 then return end

	-- fallback: the same card as a classic embed
	local desc = { bestText, "", statsText }
	if otherText then table.insert(desc, "\n" .. otherText) end
	table.insert(desc, "\n" .. serverText)
	postHook(hook, HttpService:JSONEncode({
			username = "Infin Finder", avatar_url = icon,
