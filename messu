--[[
	Teleport settings live for the whole Roblox session and survive every
	teleport, no files needed. Two lists:
	  InfinFinder_Visited  servers we've been to (never picked again)
	  InfinFinder_Logged   servers already scanned + logged (never logged twice)
]]
local TS_VISITED, TS_LOGGED = "InfinFinder_Visited", "InfinFinder_Logged"
local function tsGet(key)
	local ok, v = pcall(TeleportService.GetTeleportSetting, TeleportService, key)
	return (ok and type(v) == "table") and v or {}
end
local function tsSet(key, v) pcall(TeleportService.SetTeleportSetting, TeleportService, key, v) end

local Logged = tsGet(TS_LOGGED)
for id, t in pairs(tsGet(TS_VISITED)) do
	if type(id) == "string" then State.visited[id] = State.visited[id] or tonumber(t) or os.time() end
end
-- this server was already logged (or Roblox bounced us straight back): don't log it again
local alreadyLogged = Logged[game.JobId] ~= nil or landedSameServer

saveVisited = function()
	local copy = {}
	for id, t in pairs(State.visited) do copy[id] = t end
	tsSet(TS_VISITED, copy)
end
local function markLogged()
	Logged[game.JobId] = os.time()
	local now = os.time()
	for id, t in pairs(Logged) do
		if now - (tonumber(t) or 0) > 2700 then Logged[id] = nil end
	end
	tsSet(TS_LOGGED, Logged)
end

-- forget servers visited more than 45 minutes ago
do
	local now = os.time()
	for id, t in pairs(State.visited) do
		if now - (tonumber(t) or 0) > 2700 then State.visited[id] = nil end
	end
	State.visited[game.JobId] = now
	State.servers += 1
	saveState()
end

---------------------------------------------------------------- helpers
local function fmtMoney(n)
	if type(n) ~= "number" or n <= 0 then return "$?/s" end
	local suf = { "", "K", "M", "B", "T", "Qd", "Qn" }
	local i = 1
	while n >= 1000 and i < #suf do n /= 1000; i += 1 end
	return "$" .. (string.format("%.1f", n):gsub("%.0$", "")) .. suf[i] .. "/s"
end

local function parseMoney(str)
	str = tostring(str or ""):lower():gsub("[%s%$,]", ""):gsub("/s", "")
	local num, suf = str:match("([%d%.]+)(%a*)")
	num = tonumber(num)
	if not num then return 0 end
	return num * (({ k = 1e3, m = 1e6, b = 1e9, t = 1e12, qd = 1e15, qa = 1e15, qn = 1e18 })[suf] or 1)
end

local function request(opts)
	if not httpRequest then return nil, "your executor has no request()" end
	local ok, res = pcall(httpRequest, opts)
	if not ok then return nil, tostring(res) end
	return res
end

-- tries request(), then game:HttpGet (some phone executors block request() to roblox.com)
local function httpGetJSON(url)
	local res = request({ Url = url, Method = "GET" })
	if res and res.StatusCode == 200 then
		local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
		if ok and type(data) == "table" then return data, 200 end
	end
	if res and res.StatusCode == 429 then return nil, 429 end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" then
		local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
		if ok2 and type(data) == "table" then return data, 200 end
	end
	return nil, res and res.StatusCode or "blocked"
end

---------------------------------------------------------------- game data (M/s)
local Animals = {}
do
	local function safeRequire(inst)
		if not inst then return nil end
		local ok, mod = pcall(require, inst)
		if ok and type(mod) == "table" then return mod end
	end
	local function datas(name)
		local d = ReplicatedStorage:FindFirstChild("Datas")
		return d and d:FindFirstChild(name)
	end
	local _api, _data, _muts, _traits
	function Animals.API()
		if _api ~= nil then return _api or nil end
		_api = false
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			if d:IsA("ModuleScript") and d.Name:lower():find("animal") then
				local m = safeRequire(d)
				if type(m) == "table" and rawget(m, "CalculateGeneration") then _api = m; return m end
			end
		end
		return nil
	end
	function Animals.Data()
		if _data == nil then _data = safeRequire(datas("Animals")) or false end
		return _data or nil
	end
	function Animals.Mutations()
		if _muts == nil then _muts = safeRequire(datas("Mutations")) or false end
		return _muts or nil
	end
	function Animals.Traits()
		if _traits == nil then _traits = safeRequire(datas("Traits")) or false end
		return _traits or nil
	end

	function Animals.generation(name, mutation, traits)
		local api = Animals.API()
		if api then
			local ok, v = pcall(function() return api:CalculateGeneration(name, mutation, traits and traits[1]) end)
			v = tonumber(v)
			if ok and v and v > 0 then return v end
		end
		local d = Animals.Data()
		local e = d and d[name]
		local base = type(e) == "table" and tonumber(e.Generation)
		if not base then return 0 end
		local mult = 1
		if mutation then
			local M = Animals.Mutations()
			local mi = M and M[mutation]
			mult = (type(mi) == "table" and tonumber(mi.Modifier)) and (tonumber(mi.Modifier) + 1)
				or ({ Gold = 1.25, Diamond = 1.5, Rainbow = 10 })[mutation] or 1
		end
		local add = 0
		local Tr = Animals.Traits()
		for _, t in ipairs(traits or {}) do
			local ti = Tr and Tr[t]
			if type(ti) == "table" and tonumber(ti.MultiplierModifier) then add += tonumber(ti.MultiplierModifier) end
		end
		return base * (mult + add)
	end
end

---------------------------------------------------------------- scanner
local Scanner = {}

local function attr(inst, keys)
	for _, k in ipairs(keys) do
		local ok, v = pcall(inst.GetAttribute, inst, k)
		if ok and v ~= nil and v ~= "" then return v end
	end
end

-- who owns a base: attributes, an Owner value, or the sign text "Name's Base"
local function plotOwner(plot)
	local v = attr(plot, { "Owner", "OwnerName", "PlayerName", "OwnerUserId", "UserId" })
	if typeof(v) == "Instance" and v:IsA("Player") then return v.Name end
	if type(v) == "number" then
		local p = Players:GetPlayerByUserId(v)
		return p and p.Name or tostring(v)
	end
	if type(v) == "string" then return v end
	for _, key in ipairs({ "Owner", "OwnerName", "Player" }) do
		local c = plot:FindFirstChild(key)
		if c and c:IsA("ObjectValue") and c.Value then return c.Value.Name end
		if c and c:IsA("StringValue") and c.Value ~= "" then return c.Value end
	end
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("TextLabel") then
			local t = d.Text:gsub("<[^>]->", "")
			-- your own base is labelled "YOUR BASE" on your screen, not "Name's Base"
			if t:upper():find("YOUR BASE", 1, true) then return player.Name end
			local who = t:match("^(.-)'s [Bb]ase")
			if who and who ~= "" then return who end
		end
	end
	return nil
end

local function readTraits(v)
	local out = {}
	if type(v) == "string" and v ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, v)
		if ok and type(decoded) == "table" then
			for _, t in ipairs(decoded) do if type(t) == "string" then table.insert(out, t) end end
		else
			for t in v:gmatch("[^,%s]+") do table.insert(out, t) end
		end
	end
	return out
end

local function plain(t)
	return (tostring(t or ""):gsub("<[^>]->", ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

-- the sign shows the display name; turn it back into the game's data key
local nameIndex
local function dataKey(text)
	local D = Animals.Data()
	if not D or D[text] then return text end
	if not nameIndex then
		nameIndex = {}
		for k, e in pairs(D) do
			if type(k) == "string" and type(e) == "table" then
				nameIndex[k:lower()] = k
				if type(e.DisplayName) == "string" then nameIndex[e.DisplayName:lower()] = k end
			end
		end
	end
	return nameIndex[text:lower()] or text
end

-- reads one brainrot sign: name, the exact $X/s the game shows, mutation, rarity
local function readSign(gui)
	local name, gen, mutation, rarity
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("TextLabel") then -- hidden-by-distance signs still hold the real numbers
			local t = plain(d.Text)
			if t ~= "" then
				local n = d.Name
				if n == "DisplayName" then
					name = t
				elseif n == "Generation" then
					gen = parseMoney(t)
				elseif n == "Mutation" then
					mutation = t
				elseif n == "Rarity" then
					rarity = t
				elseif not gen and t:find("/s") then
					gen = parseMoney(t)
				end
			end
		end
	end
	if mutation then
		local l = mutation:lower()
		if l == "normal" or l == "none" then mutation = nil end
	end
	return name, gen, mutation, rarity
end

local function isSign(g)
	return g:IsA("BillboardGui") and (g.Name == "AnimalOverhead"
		or (g:FindFirstChild("DisplayName", true) and g:FindFirstChild("Generation", true))) and true or false
end

--[[
	Waits only as long as the bases actually need: streams every base in if
	the game uses streaming, then stops as soon as the number of signs stops
	changing (or MAX_LOAD_WAIT runs out).
]]
function Scanner.waitLoaded(maxWait)
	local plots = workspace:FindFirstChild("Plots") or workspace:WaitForChild("Plots", maxWait)
	if not plots then return end
	if workspace.StreamingEnabled then
		for _, plot in ipairs(plots:GetChildren()) do
			task.spawn(function()
				pcall(function() player:RequestStreamAroundAsync(plot:GetPivot().Position, 1) end)
			end)
		end
	end
	-- done once the number of signs + brainrot models stops changing for ~0.6s
	local D = Animals.Data()
	local t0, last, stable = os.clock(), -1, 0
	while os.clock() - t0 < maxWait do
		local n = 0
		for _, g in ipairs(plots:GetDescendants()) do
			if g:IsA("BillboardGui") or (D and g:IsA("Model") and type(D[g.Name]) == "table") then n += 1 end
		end
		if n > 0 and n == last then stable += 1 else stable = 0 end
		if stable >= 3 and os.clock() - t0 > 0.6 then break end
		last = n
		task.wait(0.2)
	end
end

-- which physical brainrot a sign belongs to (so one brainrot is never counted twice)
local function signOwnerModel(g)
	local m = g.Adornee
	if m and not m:IsA("Model") then m = m:FindFirstAncestorOfClass("Model") end
	return m or g:FindFirstAncestorOfClass("Model") or g.Parent
end
-- someone is carrying it (stolen brainrots ride next to a player)
local function nearAPlayer(model)
	local ok, pos = pcall(function() return model:GetPivot().Position end)
	if not ok then return false end
	for _, pl in ipairs(Players:GetPlayers()) do
		local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - pos).Magnitude < 10 then return true end
	end
	return false
end
local function blacklisted(name)
	for _, n in ipairs(Config.BLACKLIST or {}) do
		if type(n) == "string" and n:lower() == tostring(name):lower() then return true end
	end
	for _, n in ipairs(DEFAULTS.BLACKLIST or {}) do
		if type(n) == "string" and n:lower() == tostring(name):lower() then return true end
	end
	return false
end

function Scanner.scan()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return {}, "no Plots folder" end
	local D = Animals.Data()
	local counted = {} -- [model] = true
	local function real(name)
		-- with the game's data loaded, only real brainrot names count
		return not blacklisted(name) and (not D or type(D[name]) == "table")
	end

	local found = {}
	for _, plot in ipairs(plots:GetChildren()) do
		local owner = plotOwner(plot)
		if owner ~= player.Name and owner ~= player.DisplayName then
			-- 1) the game's own signs: the real M/s, mutation + traits already counted
			local signCount = {} -- [name] = how many signs this base has for it
			for _, g in ipairs(plot:GetDescendants()) do
				if isSign(g) then
					local name, gen, mutation, rarity = readSign(g)
					local mdl = signOwnerModel(g)
					if name and gen and gen > 0 and not counted[g] then
						local key = dataKey(name)
						if real(key) then
							counted[g] = true
							if mdl then counted[mdl] = true end
							signCount[key] = (signCount[key] or 0) + 1
							local e = D and D[key]
							table.insert(found, {
								name = key, mutation = mutation, traits = {},
								tierName = rarity or (type(e) == "table" and e.Rarity) or nil,
								mps = gen, owner = owner, exact = true,
							})
						end
					end
				end
			end

			-- 2) every brainrot model on the base: anything the signs missed (signs that
			--    haven't loaded, or none at all) gets the game's own M/s formula
			if D then
				local models = {} -- [name] = { model, ... }
				for _, m in ipairs(plot:GetDescendants()) do
					if m:IsA("Model") and type(D[m.Name]) == "table" and not blacklisted(m.Name)
						and m:FindFirstChildWhichIsA("BasePart", true) then
						-- skip a brainrot model nested inside another one (accessories / parts)
						local parent = m.Parent
						local nested = false
						while parent and parent ~= plot do
							if parent:IsA("Model") and type(D[parent.Name]) == "table" then nested = true break end
							parent = parent.Parent
						end
						if not nested then
							models[m.Name] = models[m.Name] or {}
							table.insert(models[m.Name], m)
						end
					end
				end
				for name, list in pairs(models) do
					local extra = #list - (signCount[name] or 0)
					for i = #list - extra + 1, #list do
						local m = list[i]
						if m and not counted[m] then
							counted[m] = true
							local mutation = attr(m, { "Mutation", "Variant" }) or (m.Parent and attr(m.Parent, { "Mutation" }))
							if mutation == "None" or mutation == "Normal" then mutation = nil end
							local traits = readTraits(attr(m, { "Traits", "Trait" }) or (m.Parent and attr(m.Parent, { "Traits" })))
							local mps = Animals.generation(name, mutation, traits)
							if mps and mps > 0 then
								table.insert(found, {
									name = name, mutation = mutation, traits = traits, tierName = D[name].Rarity,
									mps = mps, owner = owner, exact = false,
								})
							end
						end
					end
				end
			end
		end
	end
	-- 3) the carpet: brainrots walking the spawn lane. Only real brainrots, each once,
	--    and never one a player is carrying (that's a steal in progress, not a carpet spawn)
	if Config.CARPET then
		local cam = workspace.CurrentCamera
		for _, child in ipairs(workspace:GetChildren()) do
			if child ~= plots and child ~= cam and not child:IsA("Terrain")
				and not Players:GetPlayerFromCharacter(child) then
				local list = child:IsA("BillboardGui") and { child } or child:GetDescendants()
				for _, g in ipairs(list) do
					if isSign(g) then
						local name, gen, mutation, rarity = readSign(g)
						local mdl = signOwnerModel(g)
						if name and gen and gen > 0 and mdl and not counted[mdl] then
							local key = dataKey(name)
							if real(key) and not nearAPlayer(mdl) then
								counted[mdl] = true
								local e = D and D[key]
								table.insert(found, {
									name = key, mutation = mutation, traits = {},
									tierName = rarity or (type(e) == "table" and e.Rarity) or nil,
									mps = gen, exact = true, carpet = true,
								})
							end
						end
					end
				end
			end
		end
	end
	table.sort(found, function(a, b) return a.mps > b.mps end)
	return found
end

---------------------------------------------------------------- feed (Firebase) + Discord
--[[
	FEED_URL is a free Firebase Realtime Database (set up from your phone, no
	server). Each server's finds go up as one batch; Infin AJ reads new batches
	every ~1.5s and joins with the JobId. Old batches are cleaned up here.
]]
local Feed = { ok = nil, lastError = nil, posts = 0 }

local function feedBase()
	return (Config.FEED_URL:gsub("%s", ""):gsub("/+$", ""))
end

local function feedUrl(path, query, base)
	local q = query or ""
	if Config.FEED_AUTH ~= "" and not base then q ..= (q == "" and "?" or "&") .. "auth=" .. HttpService:UrlEncode(Config.FEED_AUTH) end
	return (base or feedBase()) .. path .. q
end
-- every database that gets the logs (main US one + websockets)
local function batchBases()
	local out = { false } -- false = the main feed
	local eu = (Config.EU_FEED or ""):gsub("%s", ""):gsub("/+$", "")
	if eu:find("^https://") then table.insert(out, eu) end
	return out
end

-- Firebase push keys start with the time, so "older than X" is a key range
local PUSH_CHARS = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"
local function keyForTime(ms)
	local out = {}
	for i = 8, 1, -1 do
		local idx = ms % 64
		out[i] = PUSH_CHARS:sub(idx + 1, idx + 1)
		ms = math.floor(ms / 64)
	end
	return table.concat(out)
end

local function prune(base)
	base = base or nil
	local cutoff = keyForTime((os.time() - 600) * 1000) -- older than 10 minutes
	local q = ('?orderBy=%s&endAt=%s&limitToFirst=100'):format(
		HttpService:UrlEncode('"$key"'), HttpService:UrlEncode('"' .. cutoff .. '"'))
	local res = request({ Url = feedUrl("/batches.json", q, base), Method = "GET" })
	if not res or res.StatusCode ~= 200 then return end
	local ok, old = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not ok or type(old) ~= "table" then return end
	local parts = {}
	for k in pairs(old) do table.insert(parts, ('"%s":null'):format(k)) end
	if #parts == 0 then return end
	request({
		Url = feedUrl("/batches.json", nil, base), Method = "PATCH",
		Headers = { ["Content-Type"] = "application/json" },
		Body = "{" .. table.concat(parts, ",") .. "}",
	})
end

-- country -> websocket region (Roblox puts players in servers near them)
local WS_REGION = {}
for _, c in ipairs({ "US", "CA", "MX", "PR", "GT", "CR", "PA", "DO", "JM", "HN", "SV", "NI", "CU", "BS", "TT" }) do WS_REGION[c] = "NA" end
