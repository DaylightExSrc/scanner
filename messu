---------------------------------------------------------------- main loop
local postedHere = {}

-- two quick passes a moment apart and merge them, so late-streaming bases aren't missed
local function scanTwice()
	local list, why = Scanner.scan()
	if why then return list, why end
	task.wait(0.35)
	local again = Scanner.scan()
	-- merge the passes: keep the most copies either pass saw of each brainrot (3 of the same = 3)
	local best, rows, merged = {}, {}, {}
	for _, pass in ipairs({ list, again or {} }) do
		local here = {}
		for _, f in ipairs(pass) do
			local key = f.name .. "|" .. tostring(f.mutation) .. "|" .. tostring(f.owner or (f.carpet and "carpet")) .. "|" .. tostring(f.mps)
			here[key] = (here[key] or 0) + 1
			rows[key] = rows[key] or {}
			if #rows[key] < here[key] then table.insert(rows[key], f) end
		end
		for key, n in pairs(here) do best[key] = math.max(best[key] or 0, n) end
	end
	for key, n in pairs(best) do
		for i = 1, n do table.insert(merged, rows[key][i]) end
	end
	table.sort(merged, function(a, b) return a.mps > b.mps end)
	return merged
end

local function runScan(fast)
	setStatus("scanning bases…", C.Gold)
	local list, why
	if fast then list, why = scanTwice() else list, why = Scanner.scan() end
	if why then
		setStatus(why, C.Red)
		return 0
	end
	local fresh = {}
	local seenNow = {}
	for _, f in ipairs(list) do
		local key = f.name .. "|" .. tostring(f.mutation) .. "|" .. tostring(f.owner or (f.carpet and "carpet")) .. "|" .. tostring(f.mps)
		seenNow[key] = (seenNow[key] or 0) + 1
		-- post each copy once (postedHere counts how many of this exact brainrot went out)
		if seenNow[key] > (postedHere[key] or 0) and f.mps >= (Config.MIN_LOG or 0) then
			postedHere[key] = seenNow[key]
			table.insert(fresh, f)
		end
	end
	-- Discord and the AJ feed go out at the same time
	local discordDone = false
	task.spawn(function()
		pcall(Feed.discord, fresh)
		discordDone = true
	end)
	local ok = Feed.post(fresh)
	if ok then
		State.posted += #fresh
		saveState()
		setStatus(#fresh > 0 and ("posted " .. #fresh .. " · " .. #list .. " seen") or ("nothing above your min · " .. #list .. " seen"), C.Green)
	else
		setStatus("feed error: " .. tostring(Feed.lastError), C.Red)
	end
	-- the teleport itself takes a couple of seconds, so the log still finishes sending
	local t0 = os.clock()
	while not discordDone and os.clock() - t0 < (fast and 2.5 or 4) do task.wait(0.05) end
	for _, f in ipairs(fresh) do logRow(f, ok) end
	refreshStats(#fresh)
	return #fresh
end

