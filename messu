	"PL", "CZ", "SK", "HU", "RO", "BG", "GR", "HR", "SI", "RS", "BA", "LT", "LV", "EE", "UA", "BY", "RU", "TR", "CY", "MT",
	"MA", "DZ", "TN", "EG", "ZA", "NG", "KE" }) do WS_REGION[c] = "EU" end
for _, c in ipairs({ "BR", "AR", "CL", "CO", "PE", "VE", "UY", "PY", "BO", "EC" }) do WS_REGION[c] = "SA" end
for _, c in ipairs({ "JP", "KR", "CN", "TW", "HK", "MO", "SG", "MY", "TH", "VN", "PH", "ID", "IN", "PK", "BD", "LK",
	"AE", "SA", "QA", "KW", "IL", "JO", "KZ" }) do WS_REGION[c] = "ASIA" end
for _, c in ipairs({ "AU", "NZ", "FJ", "PG" }) do WS_REGION[c] = "OCE" end
local myRegion
local function finderRegion()
	if myRegion then return myRegion end
	local ok, code = pcall(function()
		return game:GetService("LocalizationService"):GetCountryRegionForPlayerAsync(player)
	end)
	code = ok and type(code) == "string" and code:upper() or "US"
	myRegion = { country = code, region = WS_REGION[code] or "NA" }
	return myRegion
end

function Feed.post(list)
	if #list == 0 then return true end
	if feedBase() == "" or not feedBase():find("^https://") then
		Feed.ok, Feed.lastError = false, "set your FEED URL"
		return false
	end
	local finds = {}
	for _, f in ipairs(list) do
		table.insert(finds, {
			name = f.name, mutation = f.mutation, traits = f.traits, tierName = f.tierName,
			mps = f.mps, exact = f.exact, owner = f.owner, carpet = f.carpet or nil,
		})
	end
	local body = HttpService:JSONEncode({
			at = os.time(),
			jobId = game.JobId,
			placeId = game.PlaceId,
			players = #Players:GetPlayers(),
			maxPlayers = Players.MaxPlayers,
			finder = player.Name,
			region = finderRegion().region, country = finderRegion().country,
			finds = finds,
		})
	-- the extra websockets get the same log at the same time
	local bases = batchBases()
	for i = 2, #bases do
		task.spawn(request, { Url = feedUrl("/batches.json", nil, bases[i]), Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = body })
	end
	local res, err = request({
		Url = feedUrl("/batches.json"), Method = "POST",
		Headers = { ["Content-Type"] = "application/json" }, Body = body,
	})
	Feed.ok = res ~= nil and res.StatusCode == 200
	Feed.lastError = res and (res.StatusCode ~= 200 and ("database said " .. res.StatusCode
		.. (res.StatusCode == 401 and " (check your rules)" or ""))) or err
	if Feed.ok then
		Feed.posts += 1
		if Feed.posts % 8 == 1 then
			for _, b in ipairs(bases) do task.spawn(prune, b or nil) end
		end
	end
	return Feed.ok
end

--[[
	CLAIMS (bots working together)
	Every bot writes the server it's in (and the one it's about to join) to
	/claims, and skips anything another bot claimed in the last 30 minutes.
	Two bots never waste a hop on the same server.
]]
local Claims = { set = {}, loadedAt = 0 }
function Claims.claim(id)
	if feedBase() == "" or type(id) ~= "string" or id == "" then return end
	Claims.set[id] = true
	task.spawn(request, {
		Url = feedUrl("/claims/" .. id .. ".json"), Method = "PUT",
		Headers = { ["Content-Type"] = "application/json" }, Body = tostring(os.time()),
	})
end
function Claims.load()
	if feedBase() == "" then return end
	local res = request({ Url = feedUrl("/claims.json"), Method = "GET" })
	if not res or res.StatusCode ~= 200 then return end
	local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not ok or type(d) ~= "table" then return end
	local now, old = os.time(), {}
	for id, t in pairs(d) do
		if now - (tonumber(t) or 0) < 1800 then Claims.set[id] = true else table.insert(old, ('"%s":null'):format(id)) end
	end
	Claims.loadedAt = os.clock()
	-- tidy up old claims now and then
	if #old > 20 then
		task.spawn(request, {
			Url = feedUrl("/claims.json"), Method = "PATCH",
			Headers = { ["Content-Type"] = "application/json" }, Body = "{" .. table.concat(old, ",", 1, math.min(#old, 300)) .. "}",
		})
	end
end

-- the brainrot's picture from the Fandom wiki (cached across hops)
State.images = State.images or {}
local WIKI = "https://stealabrainrot.fandom.com/api.php"
local function wiki(params)
	local parts = { "format=json", "formatversion=2" }
	for k, v in pairs(params) do table.insert(parts, k .. "=" .. HttpService:UrlEncode(v)) end
	local res = request({ Url = WIKI .. "?" .. table.concat(parts, "&"), Method = "GET",
		Headers = { ["User-Agent"] = "InfinFinder/1.0" } })
	if not res or res.StatusCode ~= 200 then return nil end
	local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
	return ok and d or nil
end
local function cleanImage(src)
	if type(src) ~= "string" then return nil end
	return (src:gsub("/scale%-to%-width%-down/%d+", ""))
end
local function pageImage(title)
	local d = wiki({ action = "query", titles = title, prop = "pageimages", piprop = "original|thumbnail", pithumbsize = "400", redirects = "1" })
	local page = d and d.query and d.query.pages and d.query.pages[1]
	if not page or page.missing then return nil end
	return cleanImage((page.original and page.original.source) or (page.thumbnail and page.thumbnail.source))
end
local function brainrotImage(name)
	local cached = State.images[name]
	if cached ~= nil then return cached ~= false and cached or nil end
	local url = pageImage(name)
	if not url then
		local d = wiki({ action = "query", list = "search", srsearch = name, srlimit = "1", srnamespace = "0" })
		local hit = d and d.query and d.query.search and d.query.search[1]
		if hit then url = pageImage(hit.title) end
	end
	if not url then
		local d = wiki({ action = "query", titles = "File:" .. name .. ".png", prop = "imageinfo", iiprop = "url" })
		local page = d and d.query and d.query.pages and d.query.pages[1]
		url = cleanImage(page and page.imageinfo and page.imageinfo[1] and page.imageinfo[1].url)
	end
	State.images[name] = url or false
	saveState()
	return url
end

