-- every find goes to its own channel: OGs to the OG logs, the rest by M/s
function Feed.discord(list)
	if #list == 0 then return end
	local buckets = { og = {}, low = {}, mid = {}, high = {}, ultra = {} }
	for _, f in ipairs(list) do
		if tostring(f.tierName) == "OG" then
			table.insert(buckets.og, f)
		elseif f.mps > 2e9 then
			table.insert(buckets.ultra, f)
		elseif f.mps > 200e6 then
			table.insert(buckets.high, f)
		elseif f.mps > 10e6 then
			table.insert(buckets.mid, f)
		else
			table.insert(buckets.low, f)
		end
	end
	local jobs = {
		{ buckets.og, Config.OG_WEBHOOK, "OG Logs" },
		{ buckets.ultra, Config.WEBHOOK, "Ultralights" },
		{ buckets.high, Config.HIGH_WEBHOOK, "Highlights" },
		{ buckets.mid, Config.MID_WEBHOOK, "Midlights" },
		{ buckets.low, Config.LOW_WEBHOOK, "Lowlights" },
	}
	-- all channels send at the same time
	local left = 0
	for _, j in ipairs(jobs) do
		if #j[1] > 0 and j[2] ~= "" then
			left += 1
			task.spawn(function()
				pcall(sendCard, j[1], j[2], j[3])
				left -= 1
			end)
		end
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 4 do task.wait(0.05) end
end

--[[
	STEAL LOGS
	Infin AJ users report a steal to /steals in the feed (the AJ never has
	your webhook). Your Finder bots pick each one up, claim it so the two
	bots never double-post, and send a steal card that pings the thief's
	Discord: brainrot picture, mutation block, M/s, worth, who it came from.
]]
local Steals = {}
local function avatarUrl(userId)
	if type(userId) ~= "number" then return nil end
	local d = httpGetJSON(("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=%d&size=150x150&format=Png&isCircular=false"):format(userId))
	local t = d and d.data and d.data[1]
	return (t and t.state == "Completed") and t.imageUrl or nil
end

function Steals.post(st)
	local hook = Config.STEAL_WEBHOOK ~= "" and Config.STEAL_WEBHOOK or hook
	if hook == "" then return false end
	local mps = tonumber(st.mps) or 0
	local mutKey = st.mutation and tostring(st.mutation):lower()
	local mut = mutKey and MUT_STYLE[mutKey]
	local tier = TIER_STYLE[tostring(st.tierName)] or { "✦", 0xAAAAB0 }
	local color = (mut and mut[2]) or tier[2]
	local img = brainrotImage(tostring(st.name))
	local square = mutationIcon(st.mutation)
	local face = avatarUrl(tonumber(st.thiefId))
	local who = ("**%s** (@%s)"):format(tostring(st.thiefDisplay or st.thief), tostring(st.thief))
	local worth = tonumber(st.price) or 0
	local now = os.time()

	local headline = ("%s stole **%s**!"):format(who, tostring(st.name))
	local bestLines = {
		"## " .. (st.mutation and ((mutEmoji(st.mutation) or "🧬") .. " ") or "") .. tostring(st.name),
		("### 💸 %s"):format(fmtMoney(mps)),
		tier[1] .. " " .. tostring(st.tierName or "Unknown") .. (worth > 0 and ("  ·  💰 worth **$" .. (fmtMoney(worth):gsub("^%$", ""):gsub("/s$", "")) .. "**") or ""),
	}
	local thiefLines = {
		"**Stolen by**",
		who,
		st.victim and ("-# taken from @" .. tostring(st.victim) .. "'s base") or "-# taken from another base",
	}
	local function section(text, url, alt)
		return { type = 9, components = { { type = 10, content = text } },
			accessory = { type = 11, media = { url = url }, description = alt } }
	end
	local parts = {
		{ type = 10, content = "-# INFIN AJ  ·  PREMIUM LOGS\n## 🚨 Steal Log" },
		{ type = 10, content = headline },
		{ type = 14, divider = true, spacing = 1 },
	}
	local bestText = table.concat(bestLines, "\n")
	table.insert(parts, img and section(bestText, img, tostring(st.name)) or { type = 10, content = bestText })
	if st.mutation then
		table.insert(parts, { type = 10, content = (mutEmoji(st.mutation) or "🧬") .. " **" .. tostring(st.mutation) .. "** mutation" })
	end
	table.insert(parts, { type = 14, divider = true, spacing = 1 })
	local thiefText = table.concat(thiefLines, "\n")
	table.insert(parts, face and section(thiefText, face, tostring(st.thief)) or { type = 10, content = thiefText })
	table.insert(parts, { type = 14, divider = true, spacing = 1 })
	table.insert(parts, { type = 10, content = ("-# Infin AJ · discord.gg/infinhub | <t:%d:f>"):format(tonumber(st.at) or now) })

	local mentions = { parse = {} }
	local icon = logoUrl()
	local sep = hook:find("?", 1, true) and "&" or "?"
	local res = request({
		Url = hook .. sep .. "with_components=true", Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({
			username = "Infin AJ", avatar_url = icon, flags = 32768,
			components = { { type = 17, accent_color = color, components = parts } },
			allowed_mentions = mentions,
		}),
	})
	if res and res.StatusCode and res.StatusCode < 300 then return true end
	-- fallback: classic embed (the ping goes in the message text)
	res = request({
		Url = hook, Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({
			username = "Infin AJ", avatar_url = icon,
			content = headline,
			embeds = { {
				author = square and { name = string.upper(tostring(st.mutation)) .. " MUTATION", icon_url = square } or nil,
				title = "🚨 Steal Log",
				description = bestText .. "\n\n" .. thiefText,
				color = color,
				thumbnail = (img or face) and { url = img or face } or nil,
				footer = { text = "Infin AJ · discord.gg/infinhub", icon_url = face or icon },
				timestamp = DateTime.now():ToIsoDate(),
			} },
			allowed_mentions = mentions,
		}),
	})
	return res ~= nil and res.StatusCode ~= nil and res.StatusCode < 300
end

-- pick up new steals from the feed (runs in the background on every server)
function Steals.relay()
	if feedBase() == "" or (Config.STEAL_WEBHOOK == "" and Config.WEBHOOK == "") then return end
	local res = request({ Url = feedUrl("/steals.json", "?orderBy=" .. HttpService:UrlEncode('"$key"') .. "&limitToLast=15"), Method = "GET" })
	if not res or res.StatusCode ~= 200 then return end
	local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not ok or type(d) ~= "table" then return end
	local me = player.Name
	local keys = {}
	for k, st in pairs(d) do
		-- unsent, and not claimed in the last 20s (a bot that hopped mid-send gets retried)
		local claim = type(st) == "table" and st.claim
		local fresh = type(claim) == "table" and os.time() - (tonumber(claim.t) or 0) < 20
		if type(st) == "table" and not st.sent and not fresh and os.time() - (tonumber(st.at) or 0) < 900 then table.insert(keys, k) end
	end
	table.sort(keys)
	for _, k in ipairs(keys) do
		-- claim it, then check we won the claim (the other bot may have grabbed it)
		local tag = me .. ":" .. HttpService:GenerateGUID(false):sub(1, 8)
		request({ Url = feedUrl("/steals/" .. k .. "/claim.json"), Method = "PUT",
			Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ by = tag, t = os.time() }) })
		task.wait(0.35)
		local chk = request({ Url = feedUrl("/steals/" .. k .. "/claim/by.json"), Method = "GET" })
		local okc, owner = pcall(HttpService.JSONDecode, HttpService, chk and chk.Body or "null")
		if okc and owner == tag then
			local okp, sent = pcall(Steals.post, d[k])
			if okp and sent then
				request({ Url = feedUrl("/steals/" .. k .. "/sent.json"), Method = "PUT",
					Headers = { ["Content-Type"] = "application/json" }, Body = "true" })
			end
		end
	end
	-- tidy: drop steals older than a day
	local old = {}
	for k, st in pairs(d) do
		if type(st) == "table" and os.time() - (tonumber(st.at) or 0) > 86400 then table.insert(old, ('"%s":null'):format(k)) end
	end
	if #old > 0 then
		request({ Url = feedUrl("/steals.json"), Method = "PATCH", Headers = { ["Content-Type"] = "application/json" },
			Body = "{" .. table.concat(old, ",") .. "}" })
	end
end

--[[
	STATUS CHANNEL + HEARTBEAT
	Every bot writes a heartbeat to /finders so Infin AJ can show ONLINE /
	OFFLINE. With BOT_TOKEN + STATUS_CHANNEL set, the voice channel is renamed
	to ONLINE_NAME while bots run, and OFFLINE_NAME when the last bot stops
	(turn AUTO HOP off). Discord only allows 2 renames per 10 minutes per
	channel, so changes are spaced out and retried on the next server.
]]
local Status = {}
function Status.beat()
	if feedBase() == "" then return end
	request({
		Url = feedUrl("/finders/" .. player.UserId .. ".json"), Method = "PUT",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({ name = player.Name, at = { [".sv"] = "timestamp" }, hopping = Config.AUTO_HOP }),
	})
end
-- other bots still running? (heartbeat in the last 90s)
function Status.othersAlive()
	local res = request({ Url = feedUrl("/finders.json"), Method = "GET" })
	if not res or res.StatusCode ~= 200 then return false end
	local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not ok or type(d) ~= "table" then return false end
	-- compare against the newest heartbeat (ours, just written) so device clocks don't matter
	local nowMs = 0
	for _, f in pairs(d) do if type(f) == "table" then nowMs = math.max(nowMs, tonumber(f.at) or 0) end end
	for id, f in pairs(d) do
		if tostring(id) ~= tostring(player.UserId) and type(f) == "table" and f.hopping ~= false
			and nowMs - (tonumber(f.at) or 0) < 90000 then return true end
	end
	return false
end
--[[
	One switch for everything: saves the state to /status (every Infin AJ
	copies it onto its status pill) and, with a bot token, renames the voice
	channel to match. The AJ part needs no token.
]]
function Status.setChannel(online)
	if feedBase() == "" then return end
	local want = online and "online" or "offline"
	local cur = request({ Url = feedUrl("/status.json"), Method = "GET" })
	local okc, st = pcall(HttpService.JSONDecode, HttpService, cur and cur.Body or "null")
	st = okc and type(st) == "table" and st or {}
	-- 1) the AJs: instant, no limits
	if st.state ~= want then
		request({
			Url = feedUrl("/status.json"), Method = "PATCH", Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ state = want, at = { [".sv"] = "timestamp" }, by = player.Name }),
		})
	end
	-- 2) the voice channel: only with a bot token, and Discord allows 2 renames per 10 minutes
	if Config.BOT_TOKEN == "" or Config.STATUS_CHANNEL == "" then return end
	if st.channel == want then return end
	if os.time() - (tonumber(st.renamedAt) or 0) < 300 then return end -- next server retries
	local res = request({
		Url = "https://discord.com/api/v10/channels/" .. Config.STATUS_CHANNEL:match("%d+"), Method = "PATCH",
		Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bot " .. Config.BOT_TOKEN },
		Body = HttpService:JSONEncode({ name = online and Config.ONLINE_NAME or Config.OFFLINE_NAME }),
	})
	if res and res.StatusCode and res.StatusCode < 300 then
		request({
			Url = feedUrl("/status.json"), Method = "PATCH", Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ channel = want, renamedAt = os.time() }),
		})
	elseif res then
		warn("[Infin Finder] couldn't rename the status channel (" .. tostring(res.StatusCode) .. "): " .. tostring(res.Body):sub(1, 120))
	end
end

---------------------------------------------------------------- hopper
local Hopper = { busy = false, fetching = false, status = "idle", list = nil }

local function loaderCode()
	if Config.LOADER ~= "" then return Config.LOADER end
	if canFS and typeof(isfile) == "function" and isfile(Config.SCRIPT_FILE) then
		return ("loadstring(readfile(%q))()"):format(Config.SCRIPT_FILE)
	end
	return nil
end

-- lines up fresh servers (called while the bases load, so leaving is instant)
function Hopper.fetch()
	if Hopper.fetching then
		while Hopper.fetching do task.wait(0.1) end
		return Hopper.list
	end
	Hopper.fetching = true
	local preferred, backup = {}, {}
	Hopper.source = nil

	local function getPage(host, cursor)
		-- two bots read the list from opposite ends, so they spread out
		local order = (player.UserId % 2 == 0) and "Desc" or "Asc"
		local url = ("https://%s/v1/games/%d/servers/Public?sortOrder=%s&limit=100&excludeFullGames=true"):format(host, game.PlaceId, order)
		if cursor and cursor ~= "" then url ..= "&cursor=" .. HttpService:UrlEncode(cursor) end
		-- game:HttpGet first (works on most executors), then request()
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if ok and type(body) == "string" then
			local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
			if ok2 and type(data) == "table" and data.data then return data end
		end
		return (httpGetJSON(url))
	end

	for _, host in ipairs({ "games.roblox.com", "games.roproxy.com" }) do
		local cursor
		for _ = 1, 10 do
			local data = getPage(host, cursor)
			if not data then break end
			Hopper.source = host:match("^games%.(%a+)")
			for _, sv in ipairs(data.data or {}) do
				local playing, max = tonumber(sv.playing) or 0, tonumber(sv.maxPlayers) or 0
				if type(sv.id) == "string" and sv.id ~= game.JobId and not State.visited[sv.id]
					and not Logged[sv.id] and not Claims.set[sv.id] and playing < max then
					table.insert(playing >= Config.MIN_PLAYERS and preferred or backup, sv.id)
				end
			end
			cursor = data.nextPageCursor
			if #preferred >= 40 or not cursor then break end
		end
		if Hopper.source then break end
	end

	-- busier servers first (more brainrots), quieter ones as backup
	local function shuffle(t)
		for i = #t, 2, -1 do
			local j = math.random(i)
			t[i], t[j] = t[j], t[i]
		end
	end
	shuffle(preferred)
	shuffle(backup)
	for _, id in ipairs(backup) do table.insert(preferred, id) end
	Hopper.list = preferred
	Hopper.fetching = false
	return preferred
end

-- everything the next server needs to know, carried by the teleport itself
local function handover(rest)
	local list = {}
	for id, t in pairs(State.visited) do table.insert(list, { id, tonumber(t) or 0 }) end
	table.sort(list, function(a, b) return a[2] > b[2] end)
	local ids = {}
	for i = 1, math.min(80, #list) do ids[i] = list[i][1] end
	local queue = {}
	for i = 1, math.min(60, rest and #rest or 0) do queue[i] = rest[i] end
	return { infin = true, from = game.JobId, visited = ids, servers = State.servers, posted = State.posted, queue = queue }
end

-- tries one server; returns true only if the teleport actually started
local function tryServer(id, rest)
	local state = "wait"
	local c1 = player.OnTeleport:Connect(function(st)
		if st == Enum.TeleportState.Failed then
			state = "failed"
		elseif state == "wait" and (st == Enum.TeleportState.Started or st == Enum.TeleportState.InProgress
			or st == Enum.TeleportState.WaitingForServer) then
			state = "started"
		end
	end)
	local c2 = TeleportService.TeleportInitFailed:Connect(function(plr, _, msg)
		if plr == player then
			state = "failed"
			Hopper.lastError = tostring(msg)
		end
	end)
	local ok, err
	if id then
		ok, err = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, id, player, "", handover(rest))
	else
		-- no server list: let Roblox pick a random server (almost always a different one)
		ok, err = pcall(TeleportService.Teleport, TeleportService, game.PlaceId, player, handover())
	end
	if not ok then
		state = "failed"
		Hopper.lastError = tostring(err)
	end
	-- a server that's full / gone fails within a second or two: move straight on
	local t0 = os.clock()
	while state == "wait" and os.clock() - t0 < 2 do task.wait(0.05) end
	if state == "started" then
		-- on its way: a good teleport ends this script, so we only get past here if it stalls
		t0 = os.clock()
		while state ~= "failed" and os.clock() - t0 < 12 do task.wait(0.1) end
	end
	c1:Disconnect()
	c2:Disconnect()
	return false
end

function Hopper.hop()
	if Hopper.busy then return end
	Hopper.busy = true
	local code = loaderCode()
	if code and queueTeleport then pcall(queueTeleport, code) end

	for _ = 1, 4 do
		local list = Hopper.list
		Hopper.list = nil
		if not list or #list == 0 then
			Hopper.status = "finding a server..."
			list = Hopper.fetch()
			Hopper.list = nil
		end
		local tried = 0
		list = list or {}
		for i, id in ipairs(list) do
			-- a different JobId every time: never this server, never one we've (or the other bot has) been to
			if id ~= game.JobId and not State.visited[id] and not Claims.set[id] then
				tried += 1
				State.visited[id] = os.time()
				saveState()
				Claims.claim(id)
				local rest = {}
				for j = i + 1, #list do
					if not State.visited[list[j]] and not Claims.set[list[j]] then table.insert(rest, list[j]) end
				end
				Hopper.status = ("leaving → new server (%d) · %d queued"):format(tried, #rest)
				tryServer(id, rest)
			end
		end
		if tried == 0 then
			-- server list blocked everywhere: random server (if Roblox sends us back here,
			-- the next run notices and hops straight away)
			Hopper.status = Hopper.source and "every listed server visited, random hop" or "server list blocked, random hop"
			tryServer(nil)
		end
	end
	Hopper.status = "hop failed: " .. tostring(Hopper.lastError or "retrying")
	Hopper.busy = false
end

