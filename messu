		setStatus("already logged this server - not logging, hopping", C.Gold)
		if Config.AUTO_HOP then Hopper.hop() end
	else
		--[[
			Fast: wait only until the bases have loaded (signs stop changing,
			at most SCAN_TIME), scan twice a moment apart, post the whole lobby
