local function ensureDir()
	if typeof(makefolder) == "function" and (typeof(isfolder) ~= "function" or not isfolder(DIR)) then
		pcall(makefolder, DIR)
	end
end

local function loadJSON(path)
	if not canFS then return nil end
	local ok, data = pcall(function()
		if typeof(isfile) == "function" and not isfile(path) then return nil end
		return HttpService:JSONDecode(readfile(path))
	end)
	return ok and data or nil
end

local function saveJSON(path, data)
	if not canFS then return end
	ensureDir()
	pcall(writefile, path, HttpService:JSONEncode(data))
end

